{
  "name": "dsh-stay-calm",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "A floating whale girl for DeepSeek Harness. Mood checks and dialog replies make extra model calls that consume tokens.",
  "author": {
    "name": "hosinonisiki",
    "url": "https://github.com/hosinonisiki"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hosinonisiki/dsh-stay-calm.git"
  },
  "homepage": "https://github.com/hosinonisiki/dsh-stay-calm#readme",
  "bugs": {
    "url": "https://github.com/hosinonisiki/dsh-stay-calm/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "client-plugin",
    "web-ui",
    "desktop-pet",
    "whale",
    "whale-girl",
    "companion",
    "fun"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "assets/*.png",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "LICENSE-YunYueSama.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "prepublishOnly": "node scripts/preflight.mjs"
  }
}
